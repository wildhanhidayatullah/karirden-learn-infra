# Copy this file to .env and adjust for your local environment.
# The .env file is git-ignored and must never be committed.
CLUSTER_NAME=karirden-learn-dev
NAMESPACE=karirden-learn-data
PROFILE=dev

# Local development credentials.
# Leave a value empty (or omit the line) to have bootstrap.sh generate a random value on first run.
# Generated values are stored in .secrets, which is git-ignored.
# Never reuse these in production.
# Changing a value after the first run requires re-bootstrapping:
#   ./bootstrap.sh --teardown && ./bootstrap.sh
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
QDRANT_API_KEY=
